{
  "manifest_version": 3,
  "name": "Floating Productivity Clock + Ad Blocker",
  "version": "2.0.0",
  "description": "All-in-one productivity timer, website blocker, and powerful ad blocker",
  
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "tabs",
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "scripting",
    "webNavigation",
    "activeTab"
  ],
  
  "host_permissions": [
    "<all_urls>"
  ],
  
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "content/blocker.js",
        "content/adblock-cosmetic.js",
        "content/element-picker.js"
      ],
      "css": ["content/adblock-styles.css"],
      "run_at": "document_start"
    }
  ],
  
  "web_accessible_resources": [{
    "resources": [
      "filters/*.txt",
      "floating/clock.html",
      "floating/focus-block.html",
      "content/element-picker.css",
      "assets/sounds/*",
      "assets/fonts/*",
      "assets/icons/logo.svg"
    ],
    "matches": ["<all_urls>"]
  }],
  
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },
  
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  
  "icons": {
    "16": "assets/icons/icon16.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  }
}
